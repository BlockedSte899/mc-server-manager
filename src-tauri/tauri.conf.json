{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MC Server Manager",
  "version": "1.0.10",
  "identifier": "dev.mcsm.manager",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MC Server Manager",
        "width": 1280,
        "height": 820,
        "minWidth": 940,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Russian"]
      },
      "wix": {
        "language": ["en-US", "ru-RU"]
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "libgdk-pixbuf-2.0-0",
          "libcairo2",
          "libglib2.0-0",
          "libdbus-1-3",
          "libsoup-3.0-0",
          "liblzma5",
          "libbz2-1.0"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "libayatana-appindicator",
          "gdk-pixbuf2",
          "cairo",
          "glib2",
          "dbus-libs",
          "libsoup3",
          "xz-libs",
          "bzip2-libs"
        ],
        "epoch": 0,
        "release": "1"
      }
    }
  }
}